    <rules>
        <fullName>Cleanslate Opp Alert %28Brady%29</fullName>
        <actions>
            <name>Cleanslate_Opp_Alert_Brady</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <formula>RecordTypeId = &apos;012i0000000xxwY&apos; &amp;&amp;

ISCHANGED(StageName) &amp;&amp; 

(ispickval(StageName, &quot;Prospect&quot;) ||
ispickval(StageName, &quot;RFP Received&quot;) ||
ispickval(StageName, &quot;Pricing CLSL Approval Needed&quot;) || 
ispickval(StageName, &quot;Bid Needs Approval&quot;) ||
ispickval(StageName, &quot;Bid Submitted&quot;) ||
ispickval(StageName, &quot;Bid Negotiation&quot;) ||
ispickval(StageName, &quot;Bid Won&quot;) ||
ispickval(StageName, &quot;Contract Approval Needed&quot;) ||
ispickval(StageName, &quot;Contract Submitted&quot;) ||
ispickval(StageName, &quot;Contract Agreed &amp; Unsigned&quot;) ||
ispickval(StageName, &quot;Work Completed&quot;) ||
ispickval(StageName, &quot;Contract Executed&quot;) ||
ispickval(StageName, &quot;Contract Lost&quot;))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
