    <fieldUpdates>
        <fullName>CAM_Opportunity_Close_Date</fullName>
        <description>Triggered off of workflow of same name. When CEP Job Opportunity is created and then saved for the first time, Close Date will default to 31 days after the Open Date.</description>
        <field>CloseDate</field>
        <formula>Open_Date__c   + 31</formula>
        <name>CAM Opportunity Close Date</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
