<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>ExP_Set_ECM_Sharing_Field</fullName>
        <description>Used by criteria based sharing.</description>
        <field>ECM_Sharing__c</field>
        <formula>Program__r.Program_Short_Name__c</formula>
        <name>ExP Set ECM Sharing Field</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Status_to_Complete</fullName>
        <field>Status__c</field>
        <literalValue>Complete</literalValue>
        <name>Status to Complete</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Status_to_In_Progress</fullName>
        <field>Status__c</field>
        <literalValue>In Progress</literalValue>
        <name>Status to In Progress</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Update_Group_Class_Name</fullName>
        <field>Name</field>
        <formula>if ( RecordTypeId = &apos;012f3000000co9w&apos; || ispickval(Group_Class_Type__c, &quot;Corporate Service Day&quot;) || ispickval(Group_Class_Type__c, &quot;Core Training Series&quot;),

text(Group_Class_Type__c) &amp; &quot;, &quot; &amp; text(Start_Date__c),

text(Group_Class_Name__c) &amp; &quot;, &quot; &amp; text(Start_Date__c)

)</formula>
        <name>Update Group-Class Name</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>ExP Group %2F Class Created%2FUpdated</fullName>
        <actions>
            <name>ExP_Set_ECM_Sharing_Field</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Group_Class__c.CreatedDate</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <description>ECMv1</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Group %2F Class Name</fullName>
        <actions>
            <name>Update_Group_Class_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Group_Class__c.Start_Date__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
