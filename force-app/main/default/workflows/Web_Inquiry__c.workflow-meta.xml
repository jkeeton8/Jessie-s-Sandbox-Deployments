    <rules>
        <fullName>Contact Us Form%2C Cleanslate Customer</fullName>
        <actions>
            <name>Contact_Us_Form_Cleanslate_Customer</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Web_Inquiry__c.Inquiry_Source__c</field>
            <operation>equals</operation>
            <value>Customer,Customer Referral</value>
        </criteriaItems>
        <criteriaItems>
            <field>Web_Inquiry__c.Website_Source__c</field>
            <operation>equals</operation>
            <value>Cleanslate</value>
        </criteriaItems>
        <description>Email alert sent to BG when Web Inquiry Source is &quot;Customer&quot; or &quot;Customer Referral&quot;.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
