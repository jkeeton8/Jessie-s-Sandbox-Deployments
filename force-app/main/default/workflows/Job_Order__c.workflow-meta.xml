    <rules>
        <fullName>Job Order Closed Won</fullName>
        <actions>
            <name>Job_Order_Stage_to_Closed_Won</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Job_Order__c.Number_of_Jobs_Placements__c</field>
            <operation>greaterOrEqual</operation>
            <value>1</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Job Order Name</fullName>
        <actions>
            <name>Job_Order_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Job_Order__c.CreatedDate</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Job Order Send Out Sent</fullName>
        <actions>
            <name>Job_Order_Stage_to_Send_Out</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Job_Order__c.Close_Date__c</field>
            <operation>greaterThan</operation>
            <value>TODAY</value>
        </criteriaItems>
        <criteriaItems>
            <field>Job_Order__c.Number_of_Send_Outs__c</field>
            <operation>greaterOrEqual</operation>
            <value>1</value>
        </criteriaItems>
        <criteriaItems>
            <field>Job_Order__c.Number_of_Jobs_Placements__c</field>
            <operation>equals</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>Job_Order__c.Stage__c</field>
            <operation>notEqual</operation>
            <value>Closed Won</value>
        </criteriaItems>
        <failedMigrationToolVersion>260.9.8</failedMigrationToolVersion>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Job Order Stage Closed Lost</fullName>
        <actions>
            <name>Update_Stage_to_Closed_Lost</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>Number_of_Send_Outs__c &gt; 0

&amp;&amp;

Number_of_Jobs_Placements__c = 0

&amp;&amp; 

(Close_Date__c - Open_Date__c) &gt;= 30

&amp;&amp;

 Close_Date__c &lt; TODAY()</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Update_Stage_to_Closed_Lost</name>
                <type>FieldUpdate</type>
            </actions>
            <offsetFromField>Job_Order__c.Close_Date__c</offsetFromField>
            <timeLength>1</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Job Order Stage Closed No Send Outs</fullName>
        <actions>
            <name>Update_Stage_to_Closed_No_Send_Outs</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>Number_of_Send_Outs__c = 0

&amp;&amp;

(Close_Date__c - Open_Date__c) &gt;= 30

&amp;&amp;

Close_Date__c &lt; TODAY()</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Update_Stage_to_Closed_No_Send_Outs</name>
                <type>FieldUpdate</type>
            </actions>
            <offsetFromField>Job_Order__c.Close_Date__c</offsetFromField>
            <timeLength>1</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
