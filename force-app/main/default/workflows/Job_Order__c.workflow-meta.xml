    <rules>
        <fullName>Cara Connects Job Order Shared</fullName>
        <actions>
            <name>Cara_Connects_Job_Order_Shared</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Job_Order__c.Job_Order_Stage_Formula__c</field>
            <operation>equals</operation>
            <value>Job Order Shared</value>
        </criteriaItems>
        <criteriaItems>
            <field>Job_Order__c.Employment_Source__c</field>
            <operation>equals</operation>
            <value>Cara Connects</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.ProfileId</field>
            <operation>notContain</operation>
            <value>Administrator (Custom)</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Job_Order_Reminder</name>
                <type>Alert</type>
            </actions>
            <offsetFromField>Job_Order__c.Recommendations_Due_By__c</offsetFromField>
            <timeLength>-3</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
