        </criteriaItems>
        <criteriaItems>
            <field>Placement__c.Organization_Summary__c</field>
            <operation>equals</operation>
            <value>Cleanslate Chicago</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.ProfileId</field>
            <operation>notContain</operation>
            <value>Administrator (Custom)</value>
        </criteriaItems>
        <criteriaItems>
            <field>Placement__c.Job_Type__c</field>
            <operation>equals</operation>
            <value>Internship,Temporary,External Transitional</value>
        </criteriaItems>
        <criteriaItems>
            <field>Placement__c.Name</field>
            <operation>contains</operation>
            <value>Special Project</value>
        </criteriaItems>
        <description>This workflow rule sends an email alert when an End Date is entered on a Cleanslate internship Send Out/Employment record. This rule was requested by SG in 07/2016.</description>
