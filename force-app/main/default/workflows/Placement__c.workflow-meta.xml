        <fullName>Cleanslate Internship Ended</fullName>
        <actions>
            <name>Cleanslate_Internship_Ended_Email_Alert</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <booleanFilter>(1 or (3 and 5 or 6)) and 2 and 4</booleanFilter>
