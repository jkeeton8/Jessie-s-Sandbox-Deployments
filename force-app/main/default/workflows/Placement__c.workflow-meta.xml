        <actions>
            <name>ECM_Set_Retention_Placement_Sequence</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>ECMv2.1 workflow to set the ECM retention placement sequence field</description>
        <formula>IF(NOT(ISBLANK( Agency_Contract__c )),
