        <description>ECMv2.1 Mechanism for recording the sequence of placement types for a series of retention placements.</description>
        <field>ECM_Retention_Placement_Sequence__c</field>
        <formula>IF(LEN(ECM_Previous_Retention_Placement_Types__c) + LEN(ECM_Sequence_Name__c) &gt; 255, 
ECM_Previous_Retention_Placement_Types__c + &apos;;...&apos;,
IF(NOT(ISBLANK(ECM_Previous_Retention_Placement_Types__c)), 
ECM_Previous_Retention_Placement_Types__c + &apos;;&apos; +   SUBSTITUTE(SUBSTITUTE(ECM_Sequence_Name__c, &apos;;&apos;, &apos;_&apos;), &apos;,&apos;,&apos;_&apos;), SUBSTITUTE(SUBSTITUTE(ECM_Sequence_Name__c, &apos;;&apos;, &apos;_&apos;), &apos;,&apos;, &apos;_&apos;) ))</formula>
        <name>ECM Set Retention Placement Sequence</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
