<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>New_Question_Notification</fullName>
        <description>New Question Notification</description>
        <protected>false</protected>
        <recipients>
            <recipient>ebillups@carachicago.org</recipient>
            <type>user</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>Idea_Email_Templates/Exec_Question_Created</template>
    </alerts>
    <alerts>
        <fullName>New_Question_Notification_Owner</fullName>
        <description>New Question Notification, Owner</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>Idea_Email_Templates/Exec_Question_Created_Owner</template>
    </alerts>
    <alerts>
        <fullName>New_Suggestion_Alert</fullName>
        <description>New Suggestion Alert</description>
        <protected>false</protected>
        <recipients>
            <recipient>ebillups@carachicago.org</recipient>
            <type>user</type>
        </recipients>
        <recipients>
            <recipient>lbirchlove@carachicago.org</recipient>
            <type>user</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>Idea_Email_Templates/ERC_Suggestion_Created</template>
    </alerts>
    <alerts>
        <fullName>New_Suggestion_Alert_Owner</fullName>
        <description>New Suggestion Alert, Owner</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>Idea_Email_Templates/ERC_Suggestion_Created_Owner</template>
    </alerts>
    <alerts>
        <fullName>Question_Shared_Alert</fullName>
        <description>Question Shared Alert</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>DefaultWorkflowUser</senderType>
        <template>Idea_Email_Templates/Exec_Question_Shared</template>
    </alerts>
    <alerts>
        <fullName>Suggestion_Shared_Alert</fullName>
        <description>Suggestion Shared Alert</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>Idea_Email_Templates/ERC_Suggestion_Shared</template>
    </alerts>
    <fieldUpdates>
        <fullName>Idea_Body_Short</fullName>
        <field>Idea_Body_Short__c</field>
        <formula>LEFT (Idea_Body__c, 255)</formula>
        <name>Idea Body (Short)</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Idea Body %28Short%29</fullName>
        <actions>
            <name>Idea_Body_Short</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Idea__c.CreatedDate</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>New Suggestion Notification</fullName>
        <actions>
            <name>New_Suggestion_Alert</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Idea__c.Category__c</field>
            <operation>equals</operation>
            <value>Suggestion</value>
        </criteriaItems>
        <criteriaItems>
            <field>Idea__c.Status__c</field>
            <operation>equals</operation>
            <value>New</value>
        </criteriaItems>
        <description>Notifies ERC co-chairs when a new Suggestion has been submitted.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>New Suggestion Notification%2C Owner</fullName>
        <actions>
            <name>New_Suggestion_Alert_Owner</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Idea__c.Category__c</field>
            <operation>equals</operation>
            <value>Suggestion</value>
        </criteriaItems>
        <criteriaItems>
            <field>Idea__c.Status__c</field>
            <operation>equals</operation>
            <value>New</value>
        </criteriaItems>
        <criteriaItems>
            <field>Idea__c.OwnerId</field>
            <operation>notEqual</operation>
            <value>005i0000001Gt2aAAC</value>
        </criteriaItems>
        <description>Notifies Suggestion owner unless the Suggestion was submitted anonymously (in which the Idea owner is Cara).</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Suggestion Shared Notification</fullName>
        <actions>
            <name>Suggestion_Shared_Alert</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Idea__c.Category__c</field>
            <operation>equals</operation>
            <value>Suggestion</value>
        </criteriaItems>
        <criteriaItems>
            <field>Idea__c.Status__c</field>
            <operation>equals</operation>
            <value>Approved for Sharing</value>
        </criteriaItems>
        <criteriaItems>
            <field>Idea__c.OwnerId</field>
            <operation>notEqual</operation>
            <value>005i0000001Gt2aAAC</value>
        </criteriaItems>
        <description>Notifies Suggestion owner once their idea has been marked &quot;Approved for Sharing&quot;, unless the Suggestion was submitted anonymously (in which case the Idea owner is Cara).</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
