    <rules>
        <fullName>Advancement Referral to Job Skills Assessment</fullName>
        <actions>
            <name>Notify_Elaine</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Outbound_Referral__c.Referral_Type__c</field>
            <operation>equals</operation>
            <value>Internal - Job Skills Assessment</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case_Record__c.Program_Stage__c</field>
            <operation>contains</operation>
            <value>Advancement</value>
        </criteriaItems>
        <failedMigrationToolVersion>260.9.14</failedMigrationToolVersion>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>ExP Outbound Referral Created%2FUpdated</fullName>
        <actions>
            <name>ExP_Set_ECM_Sharing_Field</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>ECMv1</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Pending End Date</fullName>
        <actions>
            <name>Update_Pending_End_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>ischanged(Referral_Status__c)

&amp;&amp;

ispickval(priorvalue(Referral_Status__c), &quot;Pending More Information&quot;)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Pending Start Date</fullName>
        <actions>
            <name>Update_Pending_Start_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>ischanged(Referral_Status__c)

&amp;&amp;

ispickval(Referral_Status__c , &quot;Pending More Information&quot;)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Referral Closed Date</fullName>
        <actions>
            <name>Closed_Date_is_Today</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>ischanged(Referral_Status__c) 

&amp;&amp; 

(ispickval(Referral_Status__c , &quot;Referral Closed - Waitlisted&quot;)

|| 

ispickval(Referral_Status__c , &quot;Referral Closed - Referred Externally&quot;)

|| 

ispickval(Referral_Status__c , &quot;Referral Closed - Outcome Obtained&quot;)

|| 

ispickval(Referral_Status__c , &quot;Referral Closed - Outcome Not Met&quot;)

|| 

ispickval(Referral_Status__c , &quot;Referral Closed - Imported&quot;))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
