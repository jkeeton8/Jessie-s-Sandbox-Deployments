<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Notify_Creator_Client_Session_r</fullName>
        <description>Notify Creator (Client_Session__r)</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>Studentforce_Student_Mgmt_Templates/COAT_Template_Progress_Note_Update</template>
    </alerts>
    <alerts>
        <fullName>Return_to_Job_Search_Notification</fullName>
        <description>Return to Job Search Notification</description>
        <protected>false</protected>
        <recipients>
            <recipient>Participant_Service_Delivery</recipient>
            <type>group</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>Studentforce_Student_Mgmt_Templates/Return_to_Job_Search_Notification</template>
    </alerts>
    <fieldUpdates>
        <fullName>Advancement_InactiveDate_to_Adv_Mtg_Date</fullName>
        <field>Advancement_Inactive_Date__c</field>
        <formula>Date__c</formula>
