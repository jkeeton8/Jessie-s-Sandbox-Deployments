    </fieldUpdates>
    <fieldUpdates>
        <fullName>Inactivated_By_to_Service_Entry_Creator</fullName>
        <field>Inactivated_By__c</field>
        <formula>CreatedBy.Full_Name__c</formula>
        <name>Inactivated By to Service Entry Creator</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>Case_Record__c</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Inactivation_Descript_from_Service_Entry</fullName>
        <field>Inactivation_Description__c</field>
