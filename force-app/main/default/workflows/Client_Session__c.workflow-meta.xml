        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>Case_Record__c</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Inactivation_Service_Entry_ID</fullName>
        <field>Inactivation_Service_Entry_ID__c</field>
        <formula>Id</formula>
        <name>Inactivation Service Entry ID</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
        <targetObject>Case_Record__c</targetObject>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Process_Builder_Trigger_is_True</fullName>
        <field>Process_Builder_Trigger__c</field>
        <literalValue>1</literalValue>
        <name>Process Builder Trigger is True</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>true</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Progress_Note_Short</fullName>
        <field>Progress_Note_Short__c</field>
        <formula>left (Progress_Note__c, 255)</formula>
        <name>Progress Note (Short)</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
