    <rules>
        <fullName>Advancement Start Date</fullName>
        <actions>
            <name>Advancement_Start_Date_to_Adv_Mtg_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case_Record__c.Advancement_Start_Date__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Client_Session__c.Service_Entry_Name__c</field>
            <operation>equals</operation>
            <value>Advancement Meeting</value>
        </criteriaItems>
        <failedMigrationToolVersion>260.9.8</failedMigrationToolVersion>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Advancement Visit Type</fullName>
        <actions>
            <name>Visit_Type_to_Advancement</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>Service_Entry_Name__c = &quot;Advancement Meeting&quot;</formula>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Progress Note %28Short%29</fullName>
        <actions>
            <name>Progress_Note_Short</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Client_Session__c.CreatedDate</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Return to Job Search Progress Note is Created</fullName>
        <actions>
            <name>Return_to_Job_Search_Notification</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Client_Session__c.Progress_Note_Type__c</field>
            <operation>equals</operation>
            <value>Return to Job Search</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Student is Inactivated via Service Entry</fullName>
        <actions>
            <name>Inactivated_By_to_Service_Entry_Creator</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Inactivation_Descript_from_Service_Entry</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Inactivation_Service_Entry_ID</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <booleanFilter>1 or 2</booleanFilter>
        <criteriaItems>
            <field>Client_Session__c.Service_Entry_Name__c</field>
            <operation>equals</operation>
            <value>Inactivate Student,Inactivate Worker,Inactivation,Drug Test</value>
        </criteriaItems>
        <criteriaItems>
            <field>Client_Session__c.Send_Inactivation_Email__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <failedMigrationToolVersion>260.10.1</failedMigrationToolVersion>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Trigger Service Entry Process Builder</fullName>
        <active>true</active>
        <criteriaItems>
            <field>Client_Session__c.Service_Entry_Name__c</field>
            <operation>contains</operation>
            <value>Background Check,Verified</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Process_Builder_Trigger_is_True</name>
                <type>FieldUpdate</type>
            </actions>
            <timeLength>1</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <tasks>
        <fullName>Service_Follow_Up_Task</fullName>
        <assignedToType>owner</assignedToType>
        <dueDateOffset>0</dueDateOffset>
        <notifyAssignee>false</notifyAssignee>
        <offsetFromField>Client_Session__c.Task_Due_Date__c</offsetFromField>
        <priority>Normal</priority>
        <protected>false</protected>
        <status>Not Started</status>
        <subject>Service Follow Up Task</subject>
    </tasks>
</Workflow>
