        <actions>
            <name>Income_Verification_Mo</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Transaction_Line_Item__c.Income_Source__c</field>
            <operation>equals</operation>
            <value>No Income</value>
        </criteriaItems>
        <description>When &quot;No Income&quot; is selected for the field &quot;Income Source&quot; on the Service Entry (Contracts Eligibility Screening), this rule zeroes out the monthly income fields (Income, Verification Mo.; Income, 1 Mo. Prior; Income, 2 Mo. Prior, etc.).</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Recently Incarcerated</fullName>
        <actions>
            <name>Recently_Incarcerated</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <failedMigrationToolVersion>260.10.1</failedMigrationToolVersion>
        <formula>AND( 
OR( 
INCLUDES(Conviction_Outcome__c, &quot;Incarcerated (Prison)&quot;), INCLUDES(Conviction_Outcome__c, &quot;Incarcerated (Jail)&quot;) 
), 
( 
(Case_Record__r.Program_Start_Date__c-Conviction_Date__c)/365) 
&lt;=2 
)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Trigger Transaction Process</fullName>
        <actions>
            <name>Edit_Transaction_Record</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Transaction_Line_Item__c.RecordTypeId</field>
            <operation>equals</operation>
            <value>&quot;Conviction History, Verified&quot;,&quot;Conviction History, Self-Reported&quot;</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
