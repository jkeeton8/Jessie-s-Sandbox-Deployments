    <rules>
        <fullName>Formerly Incarcerated</fullName>
        <actions>
            <name>Formerly_Incarcerated</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>Transaction_Line_Item__c.Conviction_Outcome__c</field>
            <operation>includes</operation>
            <value>Incarcerated (Prison)</value>
        </criteriaItems>
        <criteriaItems>
            <field>Transaction_Line_Item__c.Conviction_Outcome__c</field>
            <operation>includes</operation>
            <value>Incarcerated (Jail)</value>
        </criteriaItems>
        <failedMigrationToolVersion>260.10.1</failedMigrationToolVersion>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Income Verification%2C No Income</fullName>
        <actions>
            <name>Income_1_Mo_Prior</name>
