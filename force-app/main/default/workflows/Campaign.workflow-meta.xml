<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Advance_Special_Event_is_False</fullName>
        <field>Advance_Special_Event_Product__c</field>
        <literalValue>0</literalValue>
        <name>Advance - Special Event is False</name>
