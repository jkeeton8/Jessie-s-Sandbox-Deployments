    <rules>
        <fullName>Concern%28Retention%29 Created</fullName>
        <actions>
            <name>Concern_Retention_Notification</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <booleanFilter>1 AND 2 AND (3 OR 4) AND 5</booleanFilter>
        <criteriaItems>
            <field>Incident__c.RecordTypeId</field>
            <operation>equals</operation>
            <value>Hold/Concern</value>
        </criteriaItems>
        <criteriaItems>
            <field>Incident__c.Effective_Date__c</field>
            <operation>greaterOrEqual</operation>
            <value>9/1/2014</value>
        </criteriaItems>
        <criteriaItems>
            <field>Incident__c.Category__c</field>
            <operation>equals</operation>
            <value>Concern</value>
        </criteriaItems>
        <criteriaItems>
            <field>Incident__c.Category__c</field>
            <operation>equals</operation>
            <value>Concern (Retention)</value>
        </criteriaItems>
        <criteriaItems>
            <field>Incident__c.Reason__c</field>
            <operation>notEqual</operation>
            <value>NCNS to Interview,Non-Responsive to CEP,Refused Job Offer</value>
        </criteriaItems>
        <description>I have updated this workflow rule to trigger if a Concern or Concern (Retention) is created. Also, I have included in the criteria that it should include anything that says "Concern".</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    </Workflow>