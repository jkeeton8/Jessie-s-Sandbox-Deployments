        <label>Update — No GED / HS Diploma</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Education_Summary_for_Job_Order__c</field>
            <value>
                <stringValue>No GED/HS Diploma</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
