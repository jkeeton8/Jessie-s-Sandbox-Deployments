<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Determine_Education_Summary</name>
        <label>Determine Education Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Associates</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Highest_Formal_Education_Acheived__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Associates</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Associates</targetReference>
            </connector>
            <label>Associates</label>
        </rules>
        <rules>
            <name>Bachelors_or_Higher</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Highest_Formal_Education_Acheived__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Bachelors</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Highest_Formal_Education_Acheived__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Masters</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Bachelors_or_Higher</targetReference>
            </connector>
            <label>Bachelors or Higher</label>
        </rules>
        <rules>
            <name>GED_High_School</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Highest_Formal_Education_Acheived__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>GED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Highest_Formal_Education_Acheived__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>High School Diploma</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_GED_HS_Diploma</targetReference>
            </connector>
            <label>GED / High School</label>
        </rules>
        <rules>
            <name>No_GED_HS_Diploma</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Highest_Formal_Education_Acheived__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>8th Grade</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_No_GED_HS_Diploma</targetReference>
            </connector>
            <label>No GED / HS Diploma</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Education Summary Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Education Summary Flow</label>
