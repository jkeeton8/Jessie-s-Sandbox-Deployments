            <field>Education_Summary_for_Job_Order__c</field>
            <value>
                <stringValue>GED/HS Diploma</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
