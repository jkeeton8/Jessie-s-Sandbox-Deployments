<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Cleanslate Work Log Generate log#</description>
    <environments>Default</environments>
    <formulas>
        <name>LogNum</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH($Record.Work_Date__c)) &amp; &apos;-&apos; &amp; SUBSTITUTE($Record.Name, &quot;WorkLog - &quot;, &quot;&quot;)&amp; &apos;-&apos; &amp; TEXT(YEAR($Record.Work_Date__c))</expression>
    </formulas>
    <interviewLabel>Cleanslate Work Log Generate log Number {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cleanslate Work Log Generate log Number</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Log_number</name>
        <label>Update Log number</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
            <field>Log__c</field>
            <value>
                <elementReference>LogNum</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Log_number</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Work_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Work_Log__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
