    <formulas>
        <name>closedate</name>
        <dataType>Date</dataType>
        <expression>if({!billingperiod}=&quot;Last Month - Standard Inspection/Cleaning&quot;,  Date(Year({!$Flow.CurrentDate}),Month({!$Flow.CurrentDate}),1)-1,
if({!billingperiod}=&quot;Last Month - Special Project Signage&quot;,  Date(Year({!$Flow.CurrentDate}),Month({!$Flow.CurrentDate}),1)-1,
if({!billingperiod}=&quot;Last Month - Special Project Other&quot;,  Date(Year({!$Flow.CurrentDate}),Month({!$Flow.CurrentDate}),1)-1,
if({!billingperiod}=&quot;This Month - Standard Inspection/Cleaning&quot;,  Date(Year({!$Flow.CurrentDate}),Month({!$Flow.CurrentDate}),1),
if({!billingperiod}=&quot;This Month - Special Project Signage&quot;,  Date(Year({!$Flow.CurrentDate}),Month({!$Flow.CurrentDate}),1),
if({!billingperiod}=&quot;This Month - Special Project Other&quot;,  Date(Year({!$Flow.CurrentDate}),Month({!$Flow.CurrentDate}),1),
NULL))))))</expression>
    </formulas>
    <formulas>
        <name>InvoiceDescription</name>
        <dataType>String</dataType>
        <expression>if({!billingperiod}=&quot;Last Month - Standard Inspection/Cleaning&quot;,  &quot;Standard Inspection/Cleaning&quot;,
if({!billingperiod}=&quot;Last Month - Special Project Signage&quot;,  &quot;SPECIAL PROJECT - Install CCLB signage&quot;,
if({!billingperiod}=&quot;Last Month - Special Project Other&quot;,  &quot;SPECIAL PROJECT - &quot;,
if({!billingperiod}=&quot;This Month - Standard Inspection/Cleaning&quot;,  &quot;Standard Inspection/Cleaning&quot;,
if({!billingperiod}=&quot;This Month - Special Project Signage&quot;,  &quot;SPECIAL PROJECT - Install CCLB signage&quot;,
if({!billingperiod}=&quot;This Month - Special Project Other&quot;,  &quot;SPECIAL PROJECT - &quot;,
NULL))))))</expression>
    </formulas>
    <formulas>
