<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>This calculates the difference between the last Start date and End date in a Send Out of the previous job as long as it meets the requirements.</description>
        <name>Difference_between_Start_Date_and_End_Date</name>
        <label>Difference between Start Date and End Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varDaysWorked</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmDaysWorked</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Rentetion_Days_Qualify</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>This shows the amount of retention days that meet the requirements to qualify.</description>
        <name>Rentetion_Days_Qualify</name>
        <label>Retention Days Qualify</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>NotQualifiedForRetentionDays</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Retention Days DO NOT Qualify</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Rentetion_Days_Qualify</name>
            <conditionLogic>1 AND 2 AND (3 OR 4) AND 5 AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Job_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Long-Term</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.End_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualifying Retention Days</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.End_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost Employment (At No Fault of Employee)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.End_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Obtained Better Employment</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetNextSendOut</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetNextSendOut</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetQualifiedRetentionDays</targetReference>
            </connector>
            <label>Outcome 1 of Retention Days Qualify</label>
        </rules>
    </decisions>
    <description>This field was made to calculate and hold the amount of qualified retention days that can be add to the overall retention count given certain requirements are met.</description>
    <environments>Default</environments>
    <formulas>
        <description>This calculates the difference between the last Start date and End date in a Send Out of the previous job as long as it meets the requirements.</description>
        <name>frmDaysWorked</name>
        <dataType>Number</dataType>
        <expression>$Record.End_Date__c - $Record.Start_Date__c</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>GetNextSendOut</name>
        <dataType>Number</dataType>
        <expression>Get.Start_Date__c - $Record.End_Date__c</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Qualifying Retention Days Calculation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Qualifying Retention Days Calculation</label>
    <processMetadataValues>
