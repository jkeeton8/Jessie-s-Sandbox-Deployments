            <value>
                <stringValue>STILL TO BE DETERMINATE</stringValue>
            </value>
        </filters>
        <object>c2g__codaCashEntryLineItem__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
