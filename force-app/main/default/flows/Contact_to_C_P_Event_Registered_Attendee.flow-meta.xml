<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Used to automatically populate the Contact field on a C&amp;P Event Registered Attendee based solely on email instead of name.</description>
    <interviewLabel>Contact to C&amp;P Event Registered Attendee {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact to C&amp;P Event Registered Attendee</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Lookup_Contact_Records</name>
        <label>Lookup Contact Records</label>
        <locationX>196</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_C_P_Registered_Attendee</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>contactemail</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputReference>contactobject</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_C_P_Registered_Attendee</name>
        <label>Update C&amp;P Registered Attendee</label>
        <locationX>197</locationX>
        <locationY>204</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>eventattendeeid</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CnP_PaaS_EVT__ContactId__c</field>
            <value>
                <elementReference>contactobject.Id</elementReference>
            </value>
        </inputAssignments>
        <object>CnP_PaaS_EVT__Event_attendee_session__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Lookup_Contact_Records</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>contactemail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>contactobject</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>eventattendeeid</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
