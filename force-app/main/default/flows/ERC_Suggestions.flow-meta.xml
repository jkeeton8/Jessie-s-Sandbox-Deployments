        <name>Formula_NumberVotesPlusOne</name>
        <dataType>Number</dataType>
        <expression>{!varIdea.Number_of_Votes__c}+1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Formula_SuggestionType</name>
        <dataType>String</dataType>
        <expression>IF({!Anonymous_or_Name} = &quot;I&apos;d like to be anonymous&quot;, &quot;Your anonymous suggestion has been submitted to ERC.&quot;, &quot;Your suggestion has been submitted to the ERC.&quot;)</expression>
    </formulas>
    <formulas>
        <name>FormulaCreatedDate</name>
        <dataType>String</dataType>
        <expression>IF(DATEVALUE({!varIdea.CreatedDate}) = DATEVALUE(&quot;2018-11-28&quot;), &quot;Staff Retreat FY19&quot;, 

TEXT(month(datevalue({!varIdea.CreatedDate}))) &amp; &quot;/&quot; &amp; text(day(datevalue({!varIdea.CreatedDate})))&amp; &quot;/&quot; &amp; text (year(datevalue({!varIdea.CreatedDate}))))</expression>
    </formulas>
    <formulas>
        <name>FormulaUserID</name>
        <dataType>String</dataType>
        <expression>{!$User.Id}</expression>
    </formulas>
    <formulas>
        <name>FormulaUserName</name>
        <dataType>String</dataType>
        <expression>{!$User.Full_Name__c}</expression>
    </formulas>
