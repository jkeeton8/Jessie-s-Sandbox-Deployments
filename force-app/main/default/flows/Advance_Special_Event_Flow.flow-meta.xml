            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StartDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Today_Date</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Advance_Special_Event_FALSE</targetReference>
            </connector>
            <label>Current or Past Event</label>
        </rules>
    </decisions>
