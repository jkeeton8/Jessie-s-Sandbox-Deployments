                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RFP Received</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pricing Creation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pricing CLSL Approval Needed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pricing Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bid Creation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bid Needs Approval</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bid Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Stage_to_Scheduled</targetReference>
            </connector>
            <label>Scheduled</label>
        </rules>
        <rules>
            <name>Ask</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bid Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bid Negotiation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bid Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contract Created</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contract Approval Needed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contract Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contract Submitted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Stage_to_Ask</targetReference>
            </connector>
            <label>Ask</label>
        </rules>
        <rules>
            <name>Declined</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contract Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Stage_to_Declined</targetReference>
            </connector>
            <label>Declined</label>
        </rules>
