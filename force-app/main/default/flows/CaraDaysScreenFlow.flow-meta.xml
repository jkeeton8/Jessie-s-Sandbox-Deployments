<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>CSVImportFlowAction</name>
        <label>CSV Import</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>CSVImportFlowAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>GetContentVersionRecord</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>contentVersionId</name>
            <value>
                <elementReference>contentVersionIdVariable</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>startDateString</name>
            <value>
                <elementReference>CaraDaysScreenFlowWelcomePicklist</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>CSVImportFlowAction</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>messageVariable</assignToReference>
            <name>message</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>recordsCreatedVariable</assignToReference>
            <name>recordsCreated</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>GetContentVersionIds</name>
        <label>Get contentVersionIds</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>contentVersionIdVariable</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ContentVersionIdsLoop</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ContentVersionIdsLoop</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>CaraDaysScreenFlowWelcomePicklistChoiceNextWeek</name>
        <choiceText>NEXT WEEK</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>NEXT_WEEK</stringValue>
        </value>
    </choices>
    <choices>
        <name>CaraDaysScreenFlowWelcomePicklistChoiceThisWeek</name>
        <choiceText>THIS WEEK</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>THIS_WEEK</stringValue>
        </value>
    </choices>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>DidUserUploadFileDecision</name>
        <label>Did User Upload File?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>FileUploadMissingFileScreen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>DidUserUploadFileDecisionYes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>contentVersionIdsCollectionVariable</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ContentVersionIdsLoop</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Cara Days Screen Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cara Days Screen Flow</label>
    <loops>
        <name>ContentVersionIdsLoop</name>
        <label>ContentVersionIds</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>contentVersionIdsCollectionVariable</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>GetContentVersionIds</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>CSVImportFlowAction</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordDeletes>
        <name>DeleteContentDocumentRecord</name>
        <label>Content Document</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CaraDaysScreenFlowSuccessScreen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetContentVersionRecord.ContentDocumentId</elementReference>
            </value>
        </filters>
        <object>ContentDocument</object>
    </recordDeletes>
    <recordLookups>
        <name>GetContentVersionRecord</name>
        <label>Content Version</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>DeleteContentDocumentRecord</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsLatest</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>CreatedById</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ContentVersion</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>CaraDaysScreenFlowHeader</name>
        <label>Cara Days Screen Flow Welcome</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>DidUserUploadFileDecision</targetReference>
        </connector>
        <fields>
            <name>CaraDaysScreenFlowWelcomeDisplayText</name>
            <fieldText>&lt;p&gt;Hello and Welcome to the Cara Days Screen Flow. Please supply a CSV file for upload to the flow. The Flow will handle processing. Automation will create Group Class Assignment records for the classes available for the week chosen below. Please click on the &apos;i&apos; icon for examples on use.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;If you have any questions or need assistance then please reach out to the support team. Nikki, Jessie, or Tom will be available to assist.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>CaraDaysScreenFlowWelcomePicklist</name>
            <choiceReferences>CaraDaysScreenFlowWelcomePicklistChoiceThisWeek</choiceReferences>
            <choiceReferences>CaraDaysScreenFlowWelcomePicklistChoiceNextWeek</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>CaraDaysScreenFlowWelcomePicklistChoiceNextWeek</defaultSelectedChoiceReference>
            <fieldText>Week to Schedule</fieldText>
            <fieldType>DropdownBox</fieldType>
            <helpText>&lt;p&gt;Examples for use: If today is a Friday, choosing NEXT WEEK to schedule will schedule students for classes next week. If today is a Monday, choosing THIS WEEK will schedule students for classes this week.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>CaraDaysScreenFlowWelcomeFileUpload</name>
            <extensionName>forceContent:fileUpload</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>Cara Days Screen Flow File Upload</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>multiple</name>
                <value>
                    <booleanValue>false</booleanValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>accept</name>
                <value>
                    <stringValue>.csv</stringValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>contentVersionIdsCollectionVariable</assignToReference>
                <name>contentVersionIds</name>
            </outputParameters>
            <outputParameters>
                <assignToReference>contentDocumentIdsCollectionVariable</assignToReference>
                <name>contentDocIds</name>
            </outputParameters>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>CaraDaysScreenFlowSuccessScreen</name>
        <label>Cara Days Screen Flow Success</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>CaraDaysScreenFlowSuccessScreenDisplayText</name>
            <fieldText>&lt;p&gt;Congratulations. Your file processed successfully. &lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Message: {!messageVariable}&lt;/p&gt;&lt;p&gt;Records Created: {!recordsCreatedVariable}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;You may now click the Finish button to exit the flow.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>FileUploadMissingFileScreen</name>
        <label>File Upload Missing File Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>CaraDaysScreenFlowHeader</targetReference>
        </connector>
        <fields>
            <name>FileUploadMissingFileScreenDisplayText</name>
            <fieldText>&lt;p&gt;Please upload file. You will now be redirected to the file upload screen. Click Next/Finish when you are ready.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CaraDaysScreenFlowHeader</targetReference>
        </connector>
    </start>
