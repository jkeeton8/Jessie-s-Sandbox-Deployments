<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <interviewLabel>Rate to Work Log {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Rate to Work Log</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Lookup_Rate_Object</name>
        <label>Lookup Rate Object</label>
        <locationX>168</locationX>
        <locationY>59</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Work_Log_Active_Rate_Set</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Rate_Set_End_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>varWorkLogWorkDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Rate_Set_Start_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>varWorkLogWorkDate</elementReference>
            </value>
        </filters>
        <object>Rate__c</object>
        <outputReference>sObjectRate</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Work_Log_Active_Rate_Set</name>
        <label>Update Work Log Active Rate Set</label>
        <locationX>169</locationX>
        <locationY>271</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varWorkLogRecordID</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Active_Rate_Set__c</field>
            <value>
                <elementReference>sObjectRate.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Work_Log__c</object>
    </recordUpdates>
    <startElementReference>Lookup_Rate_Object</startElementReference>
    <status>Active</status>
    <variables>
        <name>sObjectRate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Rate__c</objectType>
    </variables>
    <variables>
        <name>varWorkLogRecordID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varWorkLogWorkDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
