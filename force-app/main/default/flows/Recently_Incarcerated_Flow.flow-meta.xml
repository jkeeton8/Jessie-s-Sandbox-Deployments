<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Should_Mark_Recently_Incarcerated</name>
        <label>Should Mark Recently Incarcerated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Update_Case_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Case_Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>frm_RecentlyIncarceratedWithin2Years</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Record_Recently_Incarcerated</targetReference>
            </connector>
            <label>Update Case Record</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>frm_RecentlyIncarceratedWithin2Years</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK({!Get_Related_Case_Record.Program_Start_Date__c})),
  NOT(ISBLANK({!$Record.Conviction_Date__c})),
  (
    ({!Get_Related_Case_Record.Program_Start_Date__c} - {!$Record.Conviction_Date__c}) / 365
  ) &lt;= 2
)</expression>
    </formulas>
    <interviewLabel>Recently Incarcerated Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Recently Incarcerated Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Related_Case_Record</name>
        <label>Get Related Case Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Should_Mark_Recently_Incarcerated</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case_Record__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case_Record__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Case_Record_Recently_Incarcerated</name>
        <label>Update Case Record — Recently Incarcerated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Recently_Incarcerated__c</field>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Case_Record__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Case_Record</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Conviction_Outcome__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Incarcerated (Prison)</stringValue>
            </value>
        </filters>
        <filters>
            <field>Conviction_Outcome__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Incarcerated (Jail)</stringValue>
            </value>
        </filters>
        <object>Transaction_Line_Item__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
