            </conditions>
            <conditions>
                <leftValueReference>participanttimeout</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>location</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>South Side</stringValue>
                </rightValue>
            </conditions>
            <connector>
