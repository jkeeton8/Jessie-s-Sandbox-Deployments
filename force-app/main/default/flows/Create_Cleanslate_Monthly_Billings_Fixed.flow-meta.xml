    <formulas>
        <name>nextclosedate</name>
        <dataType>Date</dataType>
        <expression>IF(Month({!startdate})==12, Date(Year({!startdate})+1,1,1)-1, Date(Year({!startdate}),Month({!startdate})+1,1)-1)</expression>
    </formulas>
    <formulas>
        <name>opportunityname</name>
        <dataType>String</dataType>
