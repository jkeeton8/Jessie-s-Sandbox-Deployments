    </formulas>
    <formulas>
        <name>startdateassignmentformula</name>
        <dataType>Date</dataType>
        <expression>if ({!count} = {!maxcount}, {!Get_Cleanslate_Contract_Details.Contract_Start_Date__c}, {!startdate})</expression>
    </formulas>
