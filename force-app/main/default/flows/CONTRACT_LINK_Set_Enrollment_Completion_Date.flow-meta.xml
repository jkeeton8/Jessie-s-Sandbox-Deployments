<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Set_Enrollment_Completion_Date</name>
        <label>Set Enrollment Completion Date?</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Enrollment_Completion_Date_to_Today</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Flow to set Enrollment Completion Date on Contract Link when an Enrollment Date</description>
    <environments>Default</environments>
    <formulas>
        <description>Determines if enrollment date has been updated.</description>
        <name>IsChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Enrollment_Date__c}) || (ISNEW() &amp;&amp; !ISNULL({!$Record.Enrollment_Date__c}))</expression>
    </formulas>
    <interviewLabel>CONTRACT LINK {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CONTRACT LINK - Set Enrollment Completion Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
