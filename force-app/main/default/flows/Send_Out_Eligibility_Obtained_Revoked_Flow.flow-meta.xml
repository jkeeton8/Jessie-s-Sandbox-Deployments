        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Send_Out_Eligible__c</field>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Send_Out_Eligible_First_Time</name>
