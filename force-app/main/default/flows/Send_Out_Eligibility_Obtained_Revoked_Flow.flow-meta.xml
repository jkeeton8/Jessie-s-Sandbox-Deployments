<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Determine_Send_Out_Eligibility</name>
        <label>Determine Send Out Eligibility</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Eligibility_Revoked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Percent_to_Send_Out_Eligible__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>100.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Number_of_Unresolved_Send_Out_Holds__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Revoke_Send_Out_Eligibility</targetReference>
            </connector>
            <label>Eligibility Revoked</label>
        </rules>
        <rules>
            <name>Eligibility_Obtained_First_Time</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Percent_to_Send_Out_Eligible__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>100.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Number_of_Unresolved_Send_Out_Holds__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Send_Out_Eligible_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Send_Out_Eligible_First_Time</targetReference>
            </connector>
            <label>Eligibility Obtained First Time</label>
        </rules>
        <rules>
            <name>Eligibility_Obtained_After_Hold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Percent_to_Send_Out_Eligible__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>100.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Number_of_Unresolved_Send_Out_Holds__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Send_Out_Eligible_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Send_Out_Eligible_After_Hold</targetReference>
            </connector>
            <label>Eligibility Obtained After Hold</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Send Out Eligibility Obtained/Revoked Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Out Eligibility Obtained/Revoked Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
