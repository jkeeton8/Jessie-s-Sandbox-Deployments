    <decisions>
        <name>Subflow_Decision</name>
        <label>Subflow Decision</label>
        <locationX>475</locationX>
        <locationY>230</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Billing_Schedule_is_Fixed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.Billing_Schedule__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Fixed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.Finalize_Billings__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Cleanslate_Monthly_Billings_Fixed</targetReference>
            </connector>
            <label>Billing Schedule is Fixed</label>
        </rules>
        <rules>
            <name>Billing_Schedule_is_Variable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.Billing_Schedule__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Variable</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.Finalize_Billings__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Cleanslate_Monthly_Billings_Variable</targetReference>
            </connector>
            <label>Billing Schedule is Variable</label>
        </rules>
        <rules>
            <name>Stage_is_Contract_Lost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contract Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Cleanslate_Pipeline_Opps</targetReference>
            </connector>
            <label>Stage is Contract Lost</label>
        </rules>
        <rules>
            <name>Finalize_Billings_is_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cleanslate_Contract_Details.Finalize_Billings__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Cleanslate_Pipeline_Opps</targetReference>
            </connector>
            <label>Finalize Billings is False</label>
        </rules>
    </decisions>
