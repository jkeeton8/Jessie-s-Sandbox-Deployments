<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Used to automatically populate the Service field on a Cara Connects on boarding Group/Class.</description>
    <interviewLabel>Service to Group/Class {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Service to Group/Class</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Lookup_Service_Object</name>
        <label>Lookup Service Object</label>
        <locationX>183</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Group_Class_Service</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Cara Connects</stringValue>
            </value>
        </filters>
        <filters>
            <field>Service_Start_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>OnboardingStartDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Service_End_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>OnboardingStartDate</elementReference>
            </value>
        </filters>
        <object>Service__c</object>
        <outputReference>ServiceObject</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Group_Class_Service</name>
        <label>Update Group/Class Service</label>
        <locationX>183</locationX>
        <locationY>193</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GroupClassRecordID</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Service__c</field>
            <value>
                <elementReference>ServiceObject.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Group_Class__c</object>
    </recordUpdates>
    <startElementReference>Lookup_Service_Object</startElementReference>
    <status>Active</status>
    <variables>
        <name>GroupClassRecordID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>OnboardingStartDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>ServiceObject</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Service__c</objectType>
    </variables>
</Flow>
