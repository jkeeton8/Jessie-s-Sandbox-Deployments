<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <interviewLabel>Period to Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Period to Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Lookup_Period_Object</name>
        <label>Lookup Period Object</label>
        <locationX>201</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Opportunity_Period</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>c2g__EndDate__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>opportunityfundeddate</elementReference>
            </value>
        </filters>
        <filters>
            <field>c2g__StartDate__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>opportunityfundeddate</elementReference>
            </value>
        </filters>
        <object>c2g__codaPeriod__c</object>
        <outputReference>sObjectPeriod</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunity_Period</name>
        <label>Update Opportunity Period</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>opportunityid</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Period__c</field>
            <value>
                <elementReference>sObjectPeriod.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Lookup_Period_Object</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>opportunityfundeddate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>opportunityid</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>sObjectPeriod</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>c2g__codaPeriod__c</objectType>
    </variables>
</Flow>
