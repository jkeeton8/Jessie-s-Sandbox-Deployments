<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Case Record automations that fire when the Accepted is changed to Yes.</description>
    <environments>Default</environments>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Case Record: Accepted Automations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Record: FOC, CAP, Accepted Automations</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update Program Status to Active and Program Stage to Accepted.</description>
        <name>Update_Program_Status_Stage</name>
        <label>Update Program Status &amp; Stage</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>Date_Prgm_Stage_to_Accepted__c</field>
            <value>
                <elementReference>Today</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Program_Stage__c</field>
            <value>
                <stringValue>Accepted</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Program_Status_Stage</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>((1 OR 2 OR 3 OR 5 OR 6 OR 7 OR 8) AND 4)</filterLogic>
        <filters>
            <field>Program_Site_Track__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CCP</stringValue>
            </value>
        </filters>
        <filters>
            <field>Program_Site_Track__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CAP</stringValue>
            </value>
        </filters>
        <filters>
            <field>Program_Site_Track__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>XCH</stringValue>
            </value>
        </filters>
        <filters>
            <field>Accepted__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </filters>
        <filters>
            <field>Program_Site_Track__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CLSL Business Only</stringValue>
            </value>
        </filters>
        <filters>
            <field>Program_Site_Track__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>DIGS</stringValue>
            </value>
        </filters>
        <filters>
            <field>Program_Site_Track__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CVI</stringValue>
            </value>
        </filters>
        <filters>
            <field>Program_Site_Track__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>INVC: Co-Location</stringValue>
            </value>
        </filters>
        <object>Case_Record__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
