    <environments>Default</environments>
    <formulas>
        <name>Formula_Next_Birthday</name>
        <dataType>Date</dataType>
        <expression>IF(
    AND(
        MONTH({!$Record.Birthday__c}) = 2,
        DAY({!$Record.Birthday__c}) = 29
    ),
    IF(
        OR(
            MOD(YEAR(TODAY()), 400) = 0,
            AND(
                MOD(YEAR(TODAY()), 4) = 0,
                MOD(YEAR(TODAY()), 100) &lt;&gt; 0
            )
        ),
        IF(
            DATE(YEAR(TODAY()), 2, 29) &gt; TODAY(),
            DATE(YEAR(TODAY()), 2, 29),
            DATE(YEAR(TODAY()) + 1, 2, 28)
        ),
        IF(
            DATE(YEAR(TODAY()), 2, 28) &gt; TODAY(),
            DATE(YEAR(TODAY()), 2, 28),
            IF(
                OR(
                    MOD(YEAR(TODAY()) + 1, 400) = 0,
                    AND(
                        MOD(YEAR(TODAY()) + 1, 4) = 0,
                        MOD(YEAR(TODAY()) + 1, 100) &lt;&gt; 0
                    )
                ),
                DATE(YEAR(TODAY()) + 1, 2, 29),
                DATE(YEAR(TODAY()) + 1, 2, 28)
            )
        )
    ),
    IF(
        DATE(YEAR(TODAY()), MONTH({!$Record.Birthday__c}), DAY({!$Record.Birthday__c})) &lt;= TODAY(),
        DATE(YEAR(TODAY()) + 1, MONTH({!$Record.Birthday__c}), DAY({!$Record.Birthday__c})),
        DATE(YEAR(TODAY()), MONTH({!$Record.Birthday__c}), DAY({!$Record.Birthday__c}))
    )
)</expression>
    </formulas>
