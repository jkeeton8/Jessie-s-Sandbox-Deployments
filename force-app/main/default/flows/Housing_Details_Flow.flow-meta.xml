<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Determine_Housing_Type</name>
        <label>Determine Housing Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Set_Homeless</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Housing_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shelter</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Housing_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Recovery home</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Housing_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Emergency housing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Housing_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Halfway house</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Housing_Type_Homeless</targetReference>
            </connector>
            <label>Set Homeless</label>
        </rules>
        <rules>
            <name>Set_Permanent</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Housing_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rental through provider</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Housing_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rental through private</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Housing_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Homeownership</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Housing_Type_Permanent</targetReference>
            </connector>
            <label>Set Permanent</label>
        </rules>
        <rules>
            <name>Set_Transitional</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Housing_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Transitional housing (with specified end)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Housing_Details__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Living with family/friend (name not on lease)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Housing_Type_Transitional</targetReference>
            </connector>
            <label>Set Transitional</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Housing Details Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Housing Details Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Housing_Type_Homeless</name>
        <label>Set Housing Type — Homeless</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Housing_Type__c</field>
            <value>
                <stringValue>Homeless</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Housing_Type_Permanent</name>
        <label>Set Housing Type — Permanent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Housing_Type__c</field>
            <value>
                <stringValue>Permanent</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Housing_Type_Transitional</name>
        <label>Set Housing Type — Transitional</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Housing_Type__c</field>
            <value>
                <stringValue>Transitional</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Determine_Housing_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>012i0000000xSqEAAU</stringValue>
            </value>
        </filters>
        <filters>
            <field>Housing_Type__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Assessment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
