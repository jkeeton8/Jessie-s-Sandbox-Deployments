<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Service_History_Scope__c</fullName>
    <inlineHelpText>Used to track how broadly Program History records are shared within an organization. This is an information only field that can be used for criteria based sharing, etc. Setting or changing this field does not have any automatic affect on the system.</inlineHelpText>
    <label>Program History Scope</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Not Shared</fullName>
                <default>false</default>
                <label>Not Shared</label>
            </value>
            <value>
                <fullName>Program</fullName>
                <default>false</default>
                <label>Program</label>
            </value>
            <value>
                <fullName>Organization</fullName>
                <default>true</default>
                <label>Organization</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
