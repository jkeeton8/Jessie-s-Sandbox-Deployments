<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Time_Out</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Time_Out_Override__c, &quot;[0]?[0-9]:[0-5][0-9] [A|P]M&quot;)) 

&amp;&amp; NOT(REGEX(Time_Out_Override__c, &quot;[1]?[0-2]:[0-5][0-9] [A|P]M&quot;)) 

&amp;&amp; NOT (isblank (Time_Out_Override__c))</errorConditionFormula>
    <errorDisplayField>Time_Out_Override__c</errorDisplayField>
    <errorMessage>Enter time in format hh:mm AM/PM.</errorMessage>
</ValidationRule>
