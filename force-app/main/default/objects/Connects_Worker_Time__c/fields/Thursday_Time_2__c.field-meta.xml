<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Thursday_Time_2__c</fullName>
    <externalId>false</externalId>
    <formula>if (

isblank(Thursday_Lunch_End__c) &amp;&amp; isblank(Thursday_Lunch_Start__c),

NULL,

(

(floor(Thursday_Time_Out_Proxy__c ) + (Thursday_Time_Out_Proxy__c- floor(Thursday_Time_Out_Proxy__c))/60*100))

- (floor(Thursday_Lunch_End_Proxy__c ) + (Thursday_Lunch_End_Proxy__c - floor(Thursday_Lunch_End_Proxy__c ))/60*100))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Thursday Time (#2)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
