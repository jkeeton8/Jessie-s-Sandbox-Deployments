<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Work_Date_in_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Work_Date__c &gt; today()</errorConditionFormula>
    <errorMessage>The date of this work log is in the future and should be corrected.</errorMessage>
</ValidationRule>
