<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lunch_End</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Lunch_End__c, &quot;[0]?[0-9]:[0-5][0-9] [A|P]M&quot;))

&amp;&amp; NOT(REGEX(Lunch_End__c, &quot;[1]?[0-2]:[0-5][0-9] [A|P]M&quot;))

&amp;&amp; NOT (isblank (Lunch_End__c))</errorConditionFormula>
    <errorDisplayField>Lunch_End__c</errorDisplayField>
    <errorMessage>Enter time in format hh:mm AM/PM.</errorMessage>
</ValidationRule>
