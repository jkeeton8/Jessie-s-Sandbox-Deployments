<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Default_Time_In_Format</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Default_Time_In__c , &quot;[0]?[0-9]:[0-5][0-9] [A|P]M&quot;))

&amp;&amp; NOT(REGEX(Default_Time_In__c , &quot;[1]?[0-2]:[0-5][0-9] [A|P]M&quot;))

&amp;&amp; NOT (isblank (Default_Time_In__c ))</errorConditionFormula>
    <errorDisplayField>Default_Time_In__c</errorDisplayField>
    <errorMessage>Enter time in format hh:mm AM/PM.</errorMessage>
</ValidationRule>
