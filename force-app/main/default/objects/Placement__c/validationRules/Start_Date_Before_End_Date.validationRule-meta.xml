<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Start_Date_Before_End_Date</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISBLANK(Start_Date__c)) &amp;&amp;
NOT(ISBLANK(End_Date__c)) &amp;&amp;
Start_Date__c &gt; End_Date__c</errorConditionFormula>
    <errorDisplayField>End_Date__c</errorDisplayField>
    <errorMessage>End Date cannot be before Start Date</errorMessage>
</ValidationRule>
