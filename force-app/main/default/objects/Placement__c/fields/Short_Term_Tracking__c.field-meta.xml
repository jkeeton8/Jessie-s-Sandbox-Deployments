<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Short_Term_Tracking__c</fullName>
    <formula>IF(
AND(
ISPICKVAL(Job_Type__c,&quot;Short-Term&quot;),
ISBLANK(End_Date__c),
Days_Until_End_Date__c &gt; 0),TRUE,FALSE)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Short Term Tracking</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
