<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Most_Recent_Job_Formula__c</fullName>
    <description>Checked if the job &apos;Start Date&apos; equals the &apos;Most Recent Employment Start Date&apos;, which is a rollup field on the Case Record.</description>
    <formula>not (isblank (Start_Date__c)) &amp;&amp; Start_Date__c =  Case_Record__r.Most_Recent_Employment_Start_Date__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Most Recent Job (Formula)</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
