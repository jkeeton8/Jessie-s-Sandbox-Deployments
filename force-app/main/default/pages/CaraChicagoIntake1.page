<c:ExpCaseRecord theParentController="{!this}" csName="CompSettings-22051"/>

<!-- ***** Case Record, page 1, order 6 ***** -->
<c:ExpCaseRecord theParentController="{!this}" csName="CompSettings-22052"/>

<!-- ***** Contact, page 1, order 7 ***** -->
<c:ExpContact theParentController="{!this}" csName="CompSettings-22053"/>

