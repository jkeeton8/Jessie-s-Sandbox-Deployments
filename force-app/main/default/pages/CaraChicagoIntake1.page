<apex:pageBlock id="thePageBlock">
<apex:pageMessages id="errors"/>

<!-- **** Based off of ECM Configuration: Cara Chicago Intake ****-->

<!-- ***** Case Record, page 1, order 1 ***** -->
<c:ExpCaseRecord theParentController="{!this}" csName="CompSettings-22047"/>

<!-- ***** Contact, page 1, order 2 ***** -->
<c:ExpContact theParentController="{!this}" csName="CompSettings-22048"/>

<!-- ***** Contact, page 1, order 3 ***** -->
